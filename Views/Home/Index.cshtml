@model List<Velure.Models.Produto>

@{
    ViewData["Title"] = "Início";
}

<section class="hero-section">

    <div class="hero-content">

        <div>

            <h1>
                Ofertas da Semana 🔥
            </h1>

            <p>
                <strong>Entrega em até 30 dias</strong>
                • Peças selecionadas com até -25%
            </p>

            <span class="frete-badge">
                🚚 FRETE GRÁTIS NA REGIÃO
            </span>

        </div>

        <div class="hero-icons">

            <i class="fa-solid fa-bed"></i>

            <i class="fa-solid fa-couch"></i>

            <i class="fa-solid fa-chair"></i>

        </div>

    </div>

</section>


<section class="instagram-banner">

    <div class="instagram-info">

        <i class="fa-brands fa-instagram"></i>

        <div>

            <strong>
                Siga @@_velure_estofados no Instagram!
            </strong>

            <span>
                Fique por dentro das promoções exclusivas,
                lançamentos e ofertas relâmpago!
            </span>

        </div>

    </div>

    <a href="https://www.instagram.com/_velure_estofados?utm_source=ig_web_button_share_sheet&igsi=ZDNlZDc0MzIxNw=="
   target="_blank"
   rel="noopener noreferrer"
   class="instagram-button">

    <i class="fa-brands fa-instagram"></i>

    Seguir @@_velure_estofados

</a>

</section>


<section class="products-section">

    <div class="section-title">

        <span></span>

        <h2>
            <i class="fa-solid fa-tag"></i>
            Produtos em destaque
        </h2>

    </div>


    @if (Model == null || Model.Count == 0)
    {
        <div class="empty-products">

            <h3>
                Nenhum produto cadastrado
            </h3>

            <p>
                Cadastre produtos no banco para eles aparecerem aqui.
            </p>

        </div>
    }
    else
    {
        <div class="product-grid">

            @foreach (var produto in Model)
            {
<article class="product-card"
         data-product-card
         data-name="@produto.Nome"
         data-category="@produto.Categoria"
         data-color="@produto.Cor"
         data-premium="@produto.Destaque.ToString().ToLower()">

@if (produto.Destaque)
{
    <span class="premium-badge">
        <i class="fa-solid fa-crown"></i>
        PREMIUM
    </span>
}

                    <div class="product-image">

                        @if (!string.IsNullOrWhiteSpace(produto.ImagemUrl))
                        {
                            <img src="@produto.ImagemUrl"
                                 alt="@produto.Nome" />
                        }
                        else
                        {
                            <div class="image-placeholder">

                                <i class="fa-solid fa-couch"></i>

                            </div>
                        }

                    </div>

                    <div class="product-body">

                        <span class="product-category">
                            @produto.Categoria
                        </span>

                        <h3>
                            @produto.Nome
                        </h3>

                        @if (!string.IsNullOrWhiteSpace(produto.Cor))
                        {
                            <span class="product-color">

                                <i class="fa-solid fa-palette"></i>

                                @produto.Cor

                            </span>
                        }

                        <div class="product-price">

                            @if (produto.PrecoAntigo.HasValue)
                            {
                                <span class="old-price">

                                    @produto.PrecoAntigo.Value.ToString("C")

                                </span>
                            }

                            <strong>
                                @produto.Preco.ToString("C")
                            </strong>

                        </div>

                        @if (produto.Desconto > 0)
                        {
                            <span class="discount-badge">
                                -@produto.Desconto%
                            </span>
                        }

                        @if (!string.IsNullOrWhiteSpace(produto.Parcelamento))
                        {
                            <p class="installments">
                                @produto.Parcelamento
                            </p>
                        }

    @if (produto.Estoque <= 0)
{
    <div class="product-stock product-stock-empty">
        <i class="fa-solid fa-circle-xmark"></i>
        Produto esgotado
    </div>

    <button class="add-cart-button add-cart-disabled"
            type="button"
            disabled>

        <i class="fa-solid fa-ban"></i>
        Esgotado

    </button>
}
else
{
    @if (produto.Estoque <= 5)
    {
        <div class="product-stock product-stock-low">
            <i class="fa-solid fa-fire"></i>

            Últimas @produto.Estoque unidade(s)
        </div>
    }

    <button class="add-cart-button"
            type="button"
            data-id="@produto.Id"
            data-name="@produto.Nome"
            data-price="@produto.Preco.ToString(System.Globalization.CultureInfo.InvariantCulture)"
            data-image="@produto.ImagemUrl"
            data-stock="@produto.Estoque">

        <i class="fa-solid fa-cart-shopping"></i>
        Adicionar

    </button>
}




                    </div>



                </article>
            }



        </div>

    }  <div id="emptyProductSearch"
     class="empty-product-search"
     style="display: none;">

    <i class="fa-solid fa-magnifying-glass"></i>

    <h3>
        Nenhum produto encontrado
    </h3>

    <p>
        Tente pesquisar outro nome,
        categoria ou cor.
    </p>

</div>

</section>


