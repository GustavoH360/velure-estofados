@model Velure.Models.Produto

@{
    ViewData["Title"] = "Novo Produto";
}

<section class="admin-page">

    <div class="admin-products-header">

        <div>
            <span class="admin-label">
                VELURE ADMIN
            </span>

            <h1>
                Novo Produto
            </h1>

            <p>
                Cadastre um novo item no catálogo.
            </p>
        </div>

        <a asp-action="Produtos"
           class="admin-back-button">

            <i class="fa-solid fa-arrow-left"></i>

            Voltar

        </a>

    </div>


    <form asp-action="CriarProduto"
          method="post"
          enctype="multipart/form-data"
          class="admin-product-form">

        @Html.AntiForgeryToken()


        <div asp-validation-summary="ModelOnly"
             class="admin-validation">
        </div>


        <div class="admin-form-grid">


            <div class="admin-form-field admin-form-full">

                <label asp-for="Nome">
                    Nome do produto
                </label>

                <input asp-for="Nome"
                       placeholder="Ex: Sofá Retrátil Velure" />

                <span asp-validation-for="Nome"></span>

            </div>


            <div class="admin-form-field">

                <label asp-for="Categoria">
                    Categoria
                </label>

                <input asp-for="Categoria"
                       placeholder="Ex: Sofás" />

                <span asp-validation-for="Categoria"></span>

            </div>


            <div class="admin-form-field">

                <label asp-for="Cor">
                    Cor
                </label>

                <input asp-for="Cor"
                       placeholder="Ex: Cinza" />

            </div>


            <div class="admin-form-field">

                <label asp-for="Preco">
                    Preço
                </label>

                <input asp-for="Preco"
                       type="number"
                       step="0.01"
                       min="0" />

            </div>


            <div class="admin-form-field">

                <label asp-for="PrecoAntigo">
                    Preço antigo
                </label>

                <input asp-for="PrecoAntigo"
                       type="number"
                       step="0.01"
                       min="0" />

            </div>


            <div class="admin-form-field">

                <label asp-for="Estoque">
                    Estoque
                </label>

                <input asp-for="Estoque"
                       type="number"
                       min="0" />

            </div>


            <div class="admin-form-field">

                <label asp-for="Desconto">
                    Desconto (%)
                </label>

                <input asp-for="Desconto"
                       type="number"
                       min="0"
                       max="100" />

            </div>


            <div class="admin-form-field admin-form-full">

                <label asp-for="Parcelamento">
                    Parcelamento
                </label>

                <input asp-for="Parcelamento"
                       placeholder="Ex: 10x de R$ 149,90 sem juros" />

            </div>


            <div class="admin-form-field admin-form-full">

                <label>
                    Imagem
                </label>

                <input type="file"
                       name="imagem"
                       accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />

            </div>


            <div class="admin-form-check admin-form-full">

                <input asp-for="Ativo" />

                <label asp-for="Ativo">
                    Produto ativo na loja
                </label>

            </div>


        </div>


        <div class="admin-form-actions">

            <a asp-action="Produtos"
               class="admin-secondary-button">

                Cancelar

            </a>

            <button type="submit"
                    class="admin-primary-button">

                <i class="fa-solid fa-floppy-disk"></i>

                Salvar produto

            </button>

        </div>

    </form>

</section>



